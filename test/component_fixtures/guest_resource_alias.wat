(component
  (type $counter (resource (rep i32)))
  (core func $new (canon resource.new $counter))
  (core module $impl
    (import "r" "new" (func $new (param i32) (result i32)))
    (memory (export "memory") 1)
    (data (i32.const 0) "\08\00\00\00\03\00\00\00\00\80\ff")
    (func (export "new") (param i32) (result i32) local.get 0 call $new)
    (func (export "get") (param i32) (result i32) local.get 0)
    (func (export "bytes") (param i32) (result i32) i32.const 0)
  )
  (core instance $r (export "new" (func $new)))
  (core instance $impl (instantiate $impl (with "r" (instance $r))))
  (alias core export $impl "memory" (core memory $memory))
  (type $owned (own $counter))
  (type $borrowed (borrow $counter))
  (type $bytes (list u8))
  (func $ctor (param "value" u32) (result $owned) (canon lift (core func $impl "new")))
  (func $get (param "self" $borrowed) (result u32) (canon lift (core func $impl "get")))
  (func $get-bytes (param "self" $borrowed) (result $bytes)
    (canon lift (core func $impl "bytes") (memory $memory)))
  (component $shim
    (import "counter-type" (type $t (sub resource)))
    (type $own (own $t))
    (type $borrow (borrow $t))
    (import "ctor" (func $ctor (param "value" u32) (result $own)))
    (import "get" (func $get (param "self" $borrow) (result u32)))
    (import "get-bytes" (func $get-bytes (param "self" $borrow) (result (list u8))))
    (export $named "counter" (type $t))
    (type $named-own (own $named))
    (type $named-borrow (borrow $named))
    (export "[constructor]counter" (func $ctor) (func (param "value" u32) (result $named-own)))
    (export "[static]counter.make" (func $ctor) (func (param "value" u32) (result $named-own)))
    (export "[method]counter.get-value" (func $get) (func (param "self" $named-borrow) (result u32)))
    (export "[method]counter.get-bytes" (func $get-bytes)
      (func (param "self" $named-borrow) (result (list u8))))
  )
  (instance $methods (instantiate $shim
    (with "counter-type" (type $counter))
    (with "ctor" (func $ctor))
    (with "get" (func $get))
    (with "get-bytes" (func $get-bytes))
  ))
  ;; List the type-only alias before the interface that exports the methods.
  (instance $alias (export "counter-alias" (type $counter)))
  (export "type-alias" (instance $alias))
  (export "primary" (instance $methods))
)
